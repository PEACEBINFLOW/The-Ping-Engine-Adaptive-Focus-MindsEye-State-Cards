# ---------------------------------------------------------------------------
# Ping Engine — environment variables
# Copy to .env.local for local dev. Never commit real values.
# Neon CLI writes DATABASE_URL and DATABASE_URL_UNPOOLED for you.
# Do NOT rename these two: the app and drizzle-kit read them by name.
# ---------------------------------------------------------------------------

# Neon pooled connection string (runtime queries: HTTP driver + Pool driver).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon direct/unpooled connection string (migrations only: drizzle-kit migrate).
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Written by Neon CLI; app does not read it. Safe to leave in .env.local.
NEON_BRANCH="production"

# Public URL of the app. Use http://localhost:3000 for local dev.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
